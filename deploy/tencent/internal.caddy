(test_wvp_media_auth) {
	@use_wvp_cookie {
		method GET HEAD
		not header access-token *
	}
	request_header @use_wvp_cookie access-token {http.request.cookie.wvp_token}
	forward_auth 127.0.0.1:18978 {
		uri /api/server/version
		header_up -Authorization
		header_up -Connection
		header_up -Upgrade
		header_up -Sec-WebSocket-Protocol
	}
}

(test_wvp_routes) {
	route {
		header Content-Security-Policy "connect-src 'self' blob: wss://wvp.shizibandu.icu"

		@log_files {
			method GET
			path_regexp wvp_log_file ^/api/log/(list|file/wvp-[0-9]{4}-[0-9]{2}-[0-9]{2}\.[0-9]+\.log)$
		}
		reverse_proxy @log_files 127.0.0.1:18978 {
			header_up -Authorization
		}

		@log_stream {
			method GET
			path /channel/log
			header_regexp wvp_log_upgrade Upgrade (?i)^websocket$
		}
		reverse_proxy @log_stream 127.0.0.1:18978 {
			header_up -Authorization
		}

		@private path /index /index/* /actuator /actuator/* /doc.html /swagger* /v3/api-docs* /webjars/* /api/server/config /api/emit /api/log /api/log/* /channel/log /channel/log/*
		respond @private 404

		@media_api path /record_proxy/* /api/device/query/snap/* /api/alarm/snap/* /api/jt1078/playback/download /api/jt1078/snap
		route @media_api {
			import test_wvp_media_auth
			reverse_proxy 127.0.0.1:18978 {
				header_up -Authorization
			}
		}

		@wvp path /api/*
		reverse_proxy @wvp 127.0.0.1:18978 {
			header_up -Authorization
		}

		@playback path_regexp wvp_playback ^/(?:[^/]+/[^/]+\.live\.(?:flv|mp4|ts)|[^/]+/[^/]+/[^/]+\.m3u8|[^/]+/[^/]+/[^/]+\.(?:ts|m4s)|mp4_record/.*\.mp4)$
		route @playback {
			import test_wvp_media_auth
			reverse_proxy 127.0.0.1:18980 {
				header_up -Authorization
				header_up -access-token
				header_up -Cookie
			}
		}

		root * /srv/apps/test-wvp/current/site
		file_server
	}
}

http://127.0.0.1:18083 {
	bind 127.0.0.1
	import test_wvp_routes
}

http://127.0.0.1:18981 {
	bind 127.0.0.1
	route {
		# Bind only the dynamic RTP/RTCP sockets to the instance's private interface.
		uri /index/api/openRtpServer query local_ip 10.1.0.12
		reverse_proxy 127.0.0.1:18980
	}
}
